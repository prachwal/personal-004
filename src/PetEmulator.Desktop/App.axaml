<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PetEmulator.Desktop.Views.Controls"
             x:Class="PetEmulator.Desktop.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF1A1A1A" />
        <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#FF101010" />
        <SolidColorBrush x:Key="StatusTextBrush" Color="#FF8DFF72" />
        <SolidColorBrush x:Key="DeviceBarBackgroundBrush" Color="#FF161616" />
        <SolidColorBrush x:Key="DeviceStatusTextBrush" Color="#FFAAAAAA" />
        <SolidColorBrush x:Key="ErrorTextBrush" Color="#FFFF7070" />
        <!-- Screen surround: deliberately lighter than both the window (#1A1A1A) and the
             emulator's own black, so the rendered frame's bounds stay visible. -->
        <SolidColorBrush x:Key="ScreenFrameBackgroundBrush" Color="#FF2E2E2E" />
        <SolidColorBrush x:Key="ScreenFrameBorderBrush" Color="#FF6A6A6A" />
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <!-- StatusFieldRows subclasses ItemsControl but the theme's default ItemsControl
             template does not apply to derived types (Template stays null -> no ItemsPresenter
             -> zero item containers, silently). This gives it the standard presenter. -->
        <Style Selector="controls|StatusFieldRows">
            <Setter Property="Template">
                <ControlTemplate>
                    <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ControlTemplate>
            </Setter>
        </Style>
    </Application.Styles>
</Application>
