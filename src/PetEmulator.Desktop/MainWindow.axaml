<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PetEmulator.Desktop"
        x:Class="PetEmulator.Desktop.MainWindow"
        x:Name="RootWindow"
        x:DataType="local:MainWindowViewModel"
        Title="{Binding CurrentMachine.WindowTitle}"
        Width="960" Height="640"
        Background="#FF1A1A1A"
        KeyDown="OnKeyDown"
        KeyUp="OnKeyUp">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Reset" Command="{Binding ResetCommand}" />
                <Separator />
                <MenuItem Header="Load _Tape…" Click="OnLoadTapeClick" />
                <MenuItem Header="Load _Disk…" Click="OnLoadDiskClick" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <!-- One flat list across every machine kind (PET profiles + VIC-20) - see
                 MachineMenuEntry's doc comment. Picking an entry swaps CurrentMachine wholesale;
                 the ContentControl below picks which View to show purely from the new instance's
                 concrete type. -->
            <MenuItem Header="_Machine" ItemsSource="{Binding MachineChoices}">
                <MenuItem.ItemTemplate>
                    <DataTemplate x:DataType="local:MachineMenuEntry">
                        <MenuItem Header="{Binding Label}"
                                  Command="{Binding #RootWindow.((local:MainWindowViewModel)DataContext).SwitchMachineCommand}"
                                  CommandParameter="{Binding}" />
                    </DataTemplate>
                </MenuItem.ItemTemplate>
            </MenuItem>
        </Menu>

        <ContentControl Name="MachineHost" Focusable="True" Content="{Binding CurrentMachine}">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="local:PetMachineViewModel">
                    <local:PetMachineView />
                </DataTemplate>
                <DataTemplate DataType="local:Vic20MachineViewModel">
                    <local:Vic20MachineView />
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
    </DockPanel>
</Window>
