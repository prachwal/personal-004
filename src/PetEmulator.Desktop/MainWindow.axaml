<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PetEmulator.Desktop"
        xmlns:pet="clr-namespace:PetEmulator.Pet;assembly=PetEmulator.Pet"
        xmlns:devices="clr-namespace:PetEmulator.Pet.Devices;assembly=PetEmulator.Pet"
        x:Class="PetEmulator.Desktop.MainWindow"
        x:Name="RootWindow"
        x:DataType="local:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="960" Height="640"
        Background="#FF1A1A1A"
        KeyDown="OnKeyDown"
        KeyUp="OnKeyUp">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Reset" Command="{Binding ResetCommand}" />
                <Separator />
                <MenuItem Header="Load _Tape…" Click="OnLoadTapeClick" />
                <MenuItem Header="Load _Disk…" Click="OnLoadDiskClick" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Machine" ItemsSource="{Binding Profiles}">
                <MenuItem.ItemTemplate>
                    <DataTemplate x:DataType="pet:PetProfile">
                        <MenuItem Header="{Binding Name}"
                                  Command="{Binding #RootWindow.((local:MainWindowViewModel)DataContext).LoadProfileCommand}"
                                  CommandParameter="{Binding}" />
                    </DataTemplate>
                </MenuItem.ItemTemplate>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" Background="#FF101010" Padding="8,4">
            <TextBlock FontFamily="monospace" Foreground="#FF8DFF72" Text="{Binding StatusText}" />
        </Border>

        <!-- Where the keyboard-test input box used to live. The datasette gets its own transport
             widget (real PET hardware needs a physical PLAY press before LOAD can proceed past
             "PRESS PLAY ON TAPE #1" - a level this repo's PIA1 PA4 wiring now genuinely models,
             not just a status label); every other attached peripheral (see PetMachine.Devices,
             minus the datasette) gets a plain icon+status chip, dynamic so a profile with more/
             fewer/different devices needs no XAML change here. -->
        <Border DockPanel.Dock="Bottom" Background="#FF161616" Padding="8,4">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="Datasette">
                    <TextBlock Text="📼" FontSize="14" Foreground="{Binding TapeIconBrush}" />
                    <Button Content="▶" Padding="4,0" Command="{Binding PlayTapeCommand}" ToolTip.Tip="Press play" />
                    <Button Content="⏹" Padding="4,0" Command="{Binding StopTapeCommand}" ToolTip.Tip="Stop" />
                    <Button Content="⏏" Padding="4,0" Command="{Binding EjectTapeCommand}" ToolTip.Tip="Eject" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding OtherDevices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="16" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="devices:IPetDeviceStatus">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding Icon}" FontSize="14" />
                                <TextBlock FontFamily="monospace" Foreground="#FFAAAAAA" Text="{Binding StatusText}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <local:PetScreenControl Name="Screen" Focusable="True" />
    </DockPanel>
</Window>
