<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PetEmulator.Desktop"
             xmlns:core="clr-namespace:PetEmulator.Core;assembly=PetEmulator.Core"
             x:Class="PetEmulator.Desktop.Vic20MachineView"
             x:DataType="local:Vic20MachineViewModel">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#FF101010" Padding="8,4">
            <TextBlock FontFamily="monospace" Foreground="#FF8DFF72" Text="{Binding StatusText}" />
        </Border>

        <!-- No devices modeled for VIC-20 yet (Devices is always empty - see
             Vic20MachineViewModel's doc comment) - kept generic (not omitted) so a future device
             (cartridge, tape) shows up here automatically, the same contract PetMachineView
             relies on. -->
        <Border DockPanel.Dock="Bottom" Background="#FF161616" Padding="8,4">
            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="16" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:IDeviceStatus">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding Icon}" FontSize="14" />
                            <TextBlock FontFamily="monospace" Foreground="#FFAAAAAA" Text="{Binding StatusText}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <local:PetScreenControl Name="Screen" Focusable="True" />
    </DockPanel>
</UserControl>
