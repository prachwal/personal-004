<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PetEmulator.Desktop.Views"
             xmlns:viewModels="clr-namespace:PetEmulator.Desktop.ViewModels"
             xmlns:controls="clr-namespace:PetEmulator.Desktop.Views.Controls"
             x:Class="PetEmulator.Desktop.Views.KayproMachineView"
             x:DataType="viewModels:KayproMachineViewModel">
    <!-- Common machine frame (see PetMachineView): header top (metric left, keyboard toggle
         right - the only machine with an on-screen keyboard), collapsible keyboard zone under
         the header, bordered screen fill, widgets bottom, status bottom. -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource DeviceBarBackgroundBrush}" Padding="8,4">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <controls:DiskDriveControl />
                <TextBlock FontFamily="monospace" Foreground="{DynamicResource DeviceStatusTextBrush}" Text="Drive A: Kaypro II" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <controls:MachineHeaderBar DockPanel.Dock="Top" />

        <Border DockPanel.Dock="Top" IsVisible="{Binding KeyboardToggle.IsVisible}"
                Background="#F0101010" BorderBrush="#FF444444" BorderThickness="0,0,0,1"
                Padding="12">
            <controls:EmulatorKeyboardView x:Name="OnScreenKeyboard" Height="260" />
        </Border>

        <controls:MachineScreenFrame>
            <controls:EmulatorScreenControl Name="Screen" Focusable="True" />
        </controls:MachineScreenFrame>
    </DockPanel>
</UserControl>
