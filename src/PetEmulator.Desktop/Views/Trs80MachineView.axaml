<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PetEmulator.Desktop.Views"
             xmlns:viewModels="clr-namespace:PetEmulator.Desktop.ViewModels"
             xmlns:controls="clr-namespace:PetEmulator.Desktop.Views.Controls"
             x:Class="PetEmulator.Desktop.Views.Trs80MachineView"
             x:DataType="viewModels:Trs80MachineViewModel">
  <!-- Common machine frame (see PetMachineView): header top, widgets bottom, status bottom,
       bordered screen fill. The tape icon is read-only (firmware owns the TRS-80 motor). -->
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource DeviceBarBackgroundBrush}" Padding="8,4">
      <StackPanel Orientation="Horizontal" Spacing="16">
        <controls:DiskDriveControl />
        <TextBlock Text="📼" FontSize="14" Foreground="{Binding TapeIconBrush}" ToolTip.Tip="Tape (firmware-controlled motor - load via File menu)" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
    <controls:MachineHeaderBar DockPanel.Dock="Top" />
    <controls:MachineScreenFrame><controls:EmulatorScreenControl Name="Screen" Focusable="True" /></controls:MachineScreenFrame>
  </DockPanel>
</UserControl>
