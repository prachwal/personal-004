<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PetEmulator.Desktop.Views"
        xmlns:viewModels="clr-namespace:PetEmulator.Desktop.ViewModels"
        xmlns:models="clr-namespace:PetEmulator.Desktop.Models"
        x:Class="PetEmulator.Desktop.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="viewModels:MainWindowViewModel"
        Title="{Binding CurrentModule.WindowTitle}"
        Width="960" Height="640"
        Background="{DynamicResource WindowBackgroundBrush}">
    <DockPanel>
        <!-- Menu spans the full width on top; the status panel below it sits between the menu
             and the machine area (not full-height), collapsible to a narrow strip. -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Reset" Command="{Binding ResetCommand}" />
                <Separator />
                <MenuItem Header="_New Tape" Command="{Binding NewTapeCommand}" />
                <MenuItem Header="Load _Tape…" Command="{Binding LoadTapeCommand}" />
                <MenuItem Header="Load Tape _#2…" Command="{Binding LoadTape2Command}" />
                <MenuItem Header="New _Disk…" Command="{Binding NewDiskCommand}" />
                <MenuItem Header="Load _Disk…" Command="{Binding LoadDiskCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
             <!-- Machine profiles are separate from developer/media tools. Picking an entry swaps
                  CurrentModule wholesale; the ContentControl below picks which View to show purely
                  from the new instance's concrete type. -->
             <MenuItem Header="_Machine" ItemsSource="{Binding ModuleChoices}">
                 <MenuItem.ItemTemplate>
                     <DataTemplate x:DataType="models:ModuleMenuEntry">
                        <MenuItem Header="{Binding Label}"
                                  Command="{Binding #RootWindow.((viewModels:MainWindowViewModel)DataContext).SwitchMachineCommand}"
                                  CommandParameter="{Binding}"
                                  ItemsSource="{Binding Children}">
                            <MenuItem.ItemTemplate>
                                <DataTemplate x:DataType="models:ModuleMenuEntry">
                                    <MenuItem Header="{Binding Label}"
                                              Command="{Binding #RootWindow.((viewModels:MainWindowViewModel)DataContext).SwitchMachineCommand}"
                                              CommandParameter="{Binding}" />
                                </DataTemplate>
                            </MenuItem.ItemTemplate>
                        </MenuItem>
                    </DataTemplate>
                </MenuItem.ItemTemplate>
            </MenuItem>
            <MenuItem Header="_Tools" ItemsSource="{Binding ToolChoices}">
                <MenuItem.ItemTemplate>
                    <DataTemplate x:DataType="models:ModuleMenuEntry">
                        <MenuItem Header="{Binding Label}"
                                  Command="{Binding #RootWindow.((viewModels:MainWindowViewModel)DataContext).SwitchMachineCommand}"
                                  CommandParameter="{Binding}" />
                    </DataTemplate>
                </MenuItem.ItemTemplate>
            </MenuItem>
        </Menu>

        <!-- Left status panel between the menu and the machine area: one status per row with
             aligned values (fixed name column), collapsible to a narrow strip. WinExe has no
             console, so without this (and the log file it opens) failures were invisible. -->
        <Border DockPanel.Dock="Left" Width="280" IsVisible="{Binding IsStatusPanelExpanded}"
                Background="{DynamicResource DeviceBarBackgroundBrush}"
                BorderBrush="{DynamicResource ScreenFrameBorderBrush}" BorderThickness="0,0,1,0"
                Padding="8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="STATUS" Opacity="0.6" FontSize="11" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="«" Command="{Binding ToggleStatusPanelCommand}"
                                Padding="8,0" ToolTip.Tip="Collapse status panel" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding CurrentModule.StatusFields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:StatusField">
                                <Grid ColumnDefinitions="110,*" Margin="0,1">
                                    <TextBlock Text="{Binding Name}" Opacity="0.6" FontFamily="monospace" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="monospace" Foreground="{DynamicResource StatusTextBrush}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Spacing="4" IsVisible="{Binding HasError}">
                        <TextBlock Text="ERROR" Opacity="0.6" FontSize="11" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding LastError}" Foreground="{DynamicResource ErrorTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Content="Open Log" Command="{Binding OpenLogCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        FontSize="14" FontWeight="Bold" Padding="8,12" Margin="0,8,0,0"
                        Background="#FF245A1F" Foreground="White"
                        ToolTip.Tip="Open the session log file" />
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Left" Width="40" IsVisible="{Binding !IsStatusPanelExpanded}"
                Background="{DynamicResource DeviceBarBackgroundBrush}"
                BorderBrush="{DynamicResource ScreenFrameBorderBrush}" BorderThickness="0,0,1,0"
                Padding="4">
            <StackPanel Spacing="4">
                <Button Content="»" Command="{Binding ToggleStatusPanelCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        ToolTip.Tip="Expand status panel" />
            </StackPanel>
        </Border>

         <!-- Single view-resolution contract for all modules (see ModuleViewLocator):
              FooViewModel -> FooView by naming convention. No per-machine DataTemplate list. -->
         <ContentControl Name="MachineHost" Focusable="True" Content="{Binding CurrentModule}">
             <ContentControl.ContentTemplate>
                 <views:ModuleViewLocator />
             </ContentControl.ContentTemplate>
         </ContentControl>
    </DockPanel>
</Window>
