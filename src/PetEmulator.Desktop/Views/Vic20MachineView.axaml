<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PetEmulator.Desktop.Views"
             xmlns:viewModels="clr-namespace:PetEmulator.Desktop.ViewModels"
             xmlns:controls="clr-namespace:PetEmulator.Desktop.Views.Controls"
             xmlns:core="clr-namespace:PetEmulator.Core;assembly=PetEmulator.Core"
             x:Class="PetEmulator.Desktop.Views.Vic20MachineView"
             x:DataType="viewModels:Vic20MachineViewModel">
    <!-- Common machine frame (see PetMachineView): header top, widgets bottom, status bottom.
         Only deviation: the joystick side panel next to the screen - a game controller, not a
         keyboard, so it stays beside the screen rather than in a top keyboard zone. -->
    <DockPanel>
        <!-- Datasette gets its own dedicated icon+buttons (see PetMachineView's identical block
             and Vic20MachineViewModel's doc comment); any other future device (cartridge, ...)
             shows up in the generic ItemsControl below with no XAML change needed here. -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource DeviceBarBackgroundBrush}" Padding="8,4">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <controls:DatasetteControl />
                <controls:DiskDriveControl />
                <controls:CartridgeControl />
                <controls:Vic20ProgramProfileSelectorControl DataContext="{Binding ProgramProfileSelector}" />

                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="16" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:IDeviceStatus">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding Icon}" FontSize="14" />
                                <TextBlock FontFamily="monospace" Foreground="{DynamicResource DeviceStatusTextBrush}" Text="{Binding StatusText}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <controls:MachineHeaderBar DockPanel.Dock="Top" />

        <Grid ColumnDefinitions="*,Auto">
            <Border BorderBrush="{DynamicResource ScreenFrameBorderBrush}" BorderThickness="1" Background="{DynamicResource ScreenFrameBackgroundBrush}" Padding="8">
                <controls:PetScreenControl Name="Screen" Grid.Column="0" Focusable="True" />
            </Border>
            <controls:Vic20JoystickControl Grid.Column="1"
                                           DataContext="{Binding}"
                                           Margin="8,0,12,0" />
        </Grid>
    </DockPanel>
</UserControl>
