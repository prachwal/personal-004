<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PetEmulator.Desktop.Views.Controls"
             xmlns:viewModels="clr-namespace:PetEmulator.Desktop.ViewModels"
             x:Class="PetEmulator.Desktop.Views.Cpc6128MachineView"
             x:DataType="viewModels:Cpc6128MachineViewModel">
  <!-- Common machine frame (see PetMachineView): header top, widgets bottom, status bottom,
       bordered screen fill. -->
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource DeviceBarBackgroundBrush}" Padding="8,4">
      <StackPanel Orientation="Horizontal" Spacing="16">
        <controls:DatasetteControl />
        <controls:DiskDriveControl />
      </StackPanel>
    </Border>
    <controls:MachineHeaderBar DockPanel.Dock="Top" />
    <Border BorderBrush="{DynamicResource ScreenFrameBorderBrush}" BorderThickness="1" Background="{DynamicResource ScreenFrameBackgroundBrush}" Padding="8"><controls:PetScreenControl Name="Screen" Focusable="True" /></Border>
  </DockPanel>
</UserControl>
