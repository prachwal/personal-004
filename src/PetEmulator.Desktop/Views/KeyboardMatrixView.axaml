<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:PetEmulator.Desktop.ViewModels"
             xmlns:controls="clr-namespace:PetEmulator.Desktop.Views.Controls"
             x:Class="PetEmulator.Desktop.Views.KeyboardMatrixView"
             x:DataType="viewModels:KeyboardMatrixViewModel">
    <StackPanel Margin="24" Spacing="12">
        <ItemsControl ItemsSource="{Binding StatusFields}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="16" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="viewModels:StatusField">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Name}" FontSize="20" Opacity="0.6" />
                        <TextBlock Text="{Binding Value}" FontSize="20" FontFamily="monospace" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox ItemsSource="{Binding Machines}" SelectedItem="{Binding SelectedMachine}" />
            <TextBlock Text="ReadColumns:" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ReadColumnsText}" FontFamily="monospace" VerticalAlignment="Center" />
        </StackPanel>
        <controls:EmulatorKeyboardView x:Name="MachineKeyboard" Height="260" />
        <TextBlock Text="Raw matrix cells (row, column) - for wiring diagnostics:" />
        <ItemsControl ItemsSource="{Binding Cells}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="viewModels:KeyboardCell">
                    <ToggleButton Content="{Binding Label}" IsChecked="{Binding IsPressed, Mode=TwoWay}" Click="OnCellClick" Width="70" Height="42" Margin="2" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
