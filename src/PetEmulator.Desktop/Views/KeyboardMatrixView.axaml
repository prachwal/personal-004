<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:PetEmulator.Desktop.ViewModels"
             x:Class="PetEmulator.Desktop.Views.KeyboardMatrixView"
             x:DataType="viewModels:KeyboardMatrixViewModel">
    <StackPanel Margin="24" Spacing="12">
        <TextBlock Text="{Binding StatusText}" FontSize="20" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox ItemsSource="{Binding Machines}" SelectedItem="{Binding SelectedMachine}" />
            <TextBlock Text="ReadColumns:" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ReadColumnsText}" FontFamily="monospace" VerticalAlignment="Center" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Cells}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="viewModels:KeyboardCell">
                    <ToggleButton Content="{Binding Label}" IsChecked="{Binding IsPressed, Mode=TwoWay}" Click="OnCellClick" Width="70" Height="42" Margin="2" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
