<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:PetEmulator.Desktop.ViewModels"
             x:Class="PetEmulator.Desktop.Views.Controls.Vic20JoystickControl"
             x:DataType="viewModels:Vic20MachineViewModel">
    <Border Padding="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource DeviceBarBackgroundBrush}"
            CornerRadius="4">
        <StackPanel Spacing="6">
            <TextBlock HorizontalAlignment="Center"
                       Text="JOYSTICK"
                       FontFamily="monospace"
                       FontSize="11" />
            <Grid Width="168"
                  Height="168"
                  RowDefinitions="*,*,*"
                  ColumnDefinitions="*,*,*">
                <Button Grid.Row="0" Grid.Column="1" Tag="Up" Content="▲" Classes="joystick-button" />
                <Button Grid.Row="1" Grid.Column="0" Tag="Left" Content="◀" Classes="joystick-button" />
                <Button Grid.Row="1" Grid.Column="1" Tag="Fire" Content="FIRE" Classes="joystick-fire" />
                <Button Grid.Row="1" Grid.Column="2" Tag="Right" Content="▶" Classes="joystick-button" />
                <Button Grid.Row="2" Grid.Column="1" Tag="Down" Content="▼" Classes="joystick-button" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
