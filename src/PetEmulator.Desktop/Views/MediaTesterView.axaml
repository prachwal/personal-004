<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:PetEmulator.Desktop.ViewModels"
             xmlns:controls="clr-namespace:PetEmulator.Desktop.Views.Controls"
             x:Class="PetEmulator.Desktop.Views.MediaTesterView"
             x:DataType="viewModels:MediaTesterViewModel">
    <Grid Margin="16" RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <TextBlock Text="{Binding StatusText}" FontSize="20" />
        <Button Grid.Row="1" Content="Open D64..." Command="{Binding OpenDiskCommand}" HorizontalAlignment="Left" />
        <Grid Grid.Row="2" ColumnDefinitions="320,*" ColumnSpacing="16">
            <Border BorderBrush="Gray" BorderThickness="1" Padding="8">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <TextBlock Text="Directory" FontWeight="Bold" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Directory}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:MediaDirectoryEntry">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="0,3">
                                    <TextBlock Text="{Binding Name}" FontFamily="monospace" />
                                    <TextBlock Grid.Column="1" Text="{Binding Type}" />
                                    <TextBlock Grid.Column="2" Text="{Binding SizeInSectors, StringFormat='{}{0} blocks'}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,180,Auto,*" RowSpacing="8">
                <TextBlock Text="{Binding PreviewTitle}" FontSize="20" FontWeight="Bold" />
                <TextBlock Grid.Row="1" Text="{Binding DiskTitle}" />
                <TextBlock Grid.Row="2" Text="{Binding StartAddress}" FontFamily="monospace" />
                <TextBlock Grid.Row="3" Text="Sector map (red: allocated, blue: selected file, gray: free)" FontWeight="Bold" />
                <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SectorMap}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:MediaSectorViewModel">
                                <Border Width="14" Height="14" Margin="1" Background="{Binding Brush}" ToolTip.Tip="{Binding ToolTip}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Grid.Row="5" Text="File preview" FontWeight="Bold" />
                <controls:HexTextPreviewControl Grid.Row="6"
                                                Bytes="{Binding PreviewBytes}"
                                                StartAddress="{Binding PreviewStartAddress}"
                                                BytesPerLine="40"
                                                MaxLines="16" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
