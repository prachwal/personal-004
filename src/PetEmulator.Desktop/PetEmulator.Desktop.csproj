<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>PetEmulator.Desktop</RootNamespace>
    <ApplicationIcon />
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PetEmulator.Desktop.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="../PetEmulator.Pet/PetEmulator.Pet.csproj" />
    <ProjectReference Include="../PetEmulator.Vic20/PetEmulator.Vic20.csproj" />
    <ProjectReference Include="../PetEmulator.Kaypro/PetEmulator.Kaypro.csproj" />
    <ProjectReference Include="../PetEmulator.Trs80/PetEmulator.Trs80.csproj" />
    <ProjectReference Include="../PetEmulator.Cpc464/PetEmulator.Cpc464.csproj" />
    <!-- Direct reference, not just transitive through Vic20->Chips->Audio: Vic20MachineViewModel
         constructs AudioOutputFactory directly, and a stale project.assets.json (IDE build without
         a fresh restore right after that 3-hop chain was added) can skip copying PetEmulator.Audio.dll
         to this project's own output even though a plain `dotnet build` resolves it fine - seen as a
         FileNotFoundException on PetEmulator.Audio at Vic20MachineViewModel construction. -->
    <ProjectReference Include="../../lib/PetEmulator.Audio/PetEmulator.Audio.csproj" />
    <ProjectReference Include="../../plugins/PetEmulator.Vic20.Cartridge.Ram.24K/PetEmulator.Vic20.Cartridge.Ram.24K.csproj" />
    <ProjectReference Include="../../plugins/PetEmulator.Vic20.Cartridge.Ram/PetEmulator.Vic20.Cartridge.Ram.csproj" />
    <ProjectReference Include="../../plugins/PetEmulator.Vic20.Cartridge.Ram.8K/PetEmulator.Vic20.Cartridge.Ram.8K.csproj" />
    <ProjectReference Include="../../plugins/PetEmulator.Vic20.Cartridge.Ram.16K/PetEmulator.Vic20.Cartridge.Ram.16K.csproj" />
    <ProjectReference Include="../../plugins/PetEmulator.Vic20.Cartridge.Ram.35K/PetEmulator.Vic20.Cartridge.Ram.35K.csproj" />
    <ProjectReference Include="../../plugins/PetEmulator.Vic20.Cartridge.Rtc/PetEmulator.Vic20.Cartridge.Rtc.csproj" />
  </ItemGroup>
</Project>
